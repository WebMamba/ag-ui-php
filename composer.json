{
    "name": "webmamba/ag-ui-php",
    "description": "Development monorepo of the AG-UI SDK for PHP: the core, the Symfony bundle and the Symfony AI bridge.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "phpstan/phpdoc-parser": "^2.0",
        "psr/clock": "^1.0",
        "psr/log": "^3.0",
        "symfony/clock": "^8.0",
        "symfony/property-access": "^8.0",
        "symfony/property-info": "^8.0",
        "symfony/serializer": "^8.0",
        "symfony/service-contracts": "^3.5",
        "symfony/uid": "^8.0",
        "symfony/validator": "^8.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.75",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.0",
        "symfony/ai-agent": "^1.0@beta",
        "symfony/ai-bundle": "^1.0@beta",
        "symfony/ai-platform": "^1.0@beta",
        "symfony/browser-kit": "^8.0",
        "symfony/framework-bundle": "^8.0",
        "symfony/twig-bundle": "^8.0",
        "symfony/ux-twig-component": "^2.30|^3.0"
    },
    "autoload": {
        "psr-4": {
            "AgUi\\": "packages/core/src/",
            "AgUi\\SymfonyAi\\": "packages/symfony-ai/src/",
            "AgUi\\Bundle\\": "packages/bundle/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AgUi\\Tests\\": "packages/core/tests/",
            "AgUi\\Tools\\": "tools/",
            "AgUi\\SymfonyAi\\Tests\\": "packages/symfony-ai/tests/",
            "AgUi\\Bundle\\Tests\\": "packages/bundle/tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
