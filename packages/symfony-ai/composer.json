{
    "name": "webmamba/ag-ui-symfony-ai",
    "description": "Runs any Symfony AI agent over AG-UI: text, reasoning, tool calls, frontend tools, interrupts, shared state and generative UI.",
    "type": "library",
    "keywords": [
        "ag-ui",
        "symfony-ai",
        "agent",
        "ai",
        "sse"
    ],
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "phpstan/phpdoc-parser": "^2.0",
        "symfony/ai-agent": "^1.0@beta",
        "symfony/ai-platform": "^1.0@beta",
        "symfony/property-access": "^8.0",
        "symfony/property-info": "^8.0",
        "symfony/serializer": "^8.0",
        "symfony/service-contracts": "^3.5",
        "symfony/uid": "^8.0",
        "webmamba/ag-ui": "self.version"
    },
    "autoload": {
        "psr-4": {
            "AgUi\\SymfonyAi\\": "src/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
